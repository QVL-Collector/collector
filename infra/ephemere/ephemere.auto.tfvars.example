# Copier en ephemere.auto.tfvars (ignoré par git) pour surcharger les valeurs par défaut.
# orchestrateur, session et ip_admin sont fournis par tools/up.sh : ne pas les mettre ici.
# alb_ouvert reste false tant que X17, X20, ME4 et ME8 ne sont pas verts (US-004 AC10).

# Repli MS3 si le filtre réseau d'IMDS échoue en XP01 (G4) : IMDS fermé aux pods.
# imds_limite_sauts = 1

# Selon la mesure de densité de XP01.
# delegation_prefixes = true

# Selon D09.
# journaux_plan_controle = ["audit"]
