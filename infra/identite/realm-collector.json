{
  "realm": "collector",
  "displayName": "Collector",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": ["totpAppFreeOTPName", "totpAppGoogleName", "totpAppMicrosoftAuthenticatorName"],
  "browserFlow": "navigateur collector",
  "roles": {
    "realm": [
      { "name": "acheteur", "description": "Achète des articles publiés" },
      { "name": "vendeur", "description": "Met des articles en vente" },
      { "name": "moderation", "description": "Tranche les articles à vérifier" },
      { "name": "administration", "description": "Administre la plateforme" },
      {
        "name": "admin",
        "description": "Administrateur de Collector, second facteur obligatoire",
        "composite": true,
        "composites": { "realm": ["moderation", "administration"] }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-collector",
    "composite": true,
    "composites": { "realm": ["acheteur"] }
  },
  "clients": [
    {
      "clientId": "collector-web",
      "name": "Collector (site)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "rootUrl": "https://collector.qvl-project.com",
      "baseUrl": "/",
      "redirectUris": [
        "https://collector.qvl-project.com/rappel",
        "https://collector.localhost/rappel",
        "http://localhost:5173/rappel"
      ],
      "webOrigins": [
        "https://collector.qvl-project.com",
        "https://collector.localhost",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://collector.qvl-project.com/##https://collector.localhost/##http://localhost:5173/",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "audience place-de-marche",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "place-de-marche",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience transactions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "transactions",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience interactions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "interactions",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "collector-web",
      "roles": ["acheteur", "vendeur", "admin", "moderation", "administration"]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "role admin",
      "config": { "condUserRole": "admin", "negate": "false" }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "navigateur collector",
      "description": "Flux du navigateur : second facteur OTP imposé au seul rôle admin",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "navigateur collector formulaires",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "navigateur collector formulaires",
      "description": "Identifiant et mot de passe, puis second facteur selon le rôle",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "navigateur collector OTP admin",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "navigateur collector OTP admin",
      "description": "OTP exigé si l'utilisateur porte le rôle admin",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "role admin",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
